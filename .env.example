# Reference only: the server reads these from its process environment and does
# not load .env files. Put them in your MCP client's "env" block.
UNIFI_NETWORK_HOST=192.168.1.1
UNIFI_NETWORK_API_KEY=your-api-key-here
# Absolute path to the console's PEM certificate (README: Environment Variables)
# UNIFI_NETWORK_CA_CERT=/absolute/path/to/unifi-console.pem
UNIFI_NETWORK_VERIFY_SSL=true
UNIFI_NETWORK_READ_ONLY=true
# Cloud Connector only, with UNIFI_NETWORK_HOST=api.ui.com
# UNIFI_NETWORK_CONSOLE_ID=
