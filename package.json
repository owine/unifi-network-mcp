{
  "name": "@owine/unifi-network-mcp",
  "version": "2.15.0",
  "description": "MCP server exposing the UniFi Network Integration API as tools for Claude and other MCP clients",
  "main": "dist/index.js",
  "bin": {
    "unifi-network-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:package": "pnpm run build && sh scripts/smoke-package.sh"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owine/unifi-network-mcp.git"
  },
  "keywords": [
    "unifi",
    "network",
    "mcp",
    "model-context-protocol",
    "ubiquiti",
    "unifi-network",
    "mcp-server"
  ],
  "author": "owine",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.29.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "lefthook": "2.2.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
